      "isGame": true,
      "gameHtml": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\">\r\n    <title>OXO: NEON PROTOCOL HYPER</title>\r\n    <script src=\"https://cdn.tailwindcss.com\"></script>\r\n    <link href=\"https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Rajdhani:wght@500;700&display=swap\" rel=\"stylesheet\">\r\n    <style>\r\n        :root {\r\n            --neon-blue: #00f3ff;\r\n            --neon-pink: #ff00ff;\r\n            --bg-dark: #020205;\r\n        }\r\n        body {\r\n            background-color: var(--bg-dark);\r\n            color: white;\r\n            font-family: 'Rajdhani', sans-serif;\r\n            touch-action: manipulation;\r\n            overflow: hidden;\r\n            height: 100vh;\r\n            margin: 0;\r\n            display: flex;\r\n            flex-direction: column;\r\n        }\r\n        .orbitron { font-family: 'Orbitron', sans-serif; }\r\n\r\n        /* Bot Styling & Animations */\r\n        #chibi-bot {\r\n            position: absolute;\r\n            width: 60px;\r\n            height: 60px;\r\n            z-index: 50;\r\n            pointer-events: none;\r\n            transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);\r\n            left: 0;\r\n            top: 0;\r\n            color: var(--neon-blue);\r\n        }\r\n\r\n        @keyframes float { 0%, 100% { transform: translateY(0) rotate(0deg); } 50% { transform: translateY(-10px) rotate(5deg); } }\r\n        @keyframes hyper-spin { \r\n            0% { transform: translate(-50%, -50%) rotate(0deg) scale(1); opacity: 1; } \r\n            100% { transform: translate(-50%, -50%) rotate(1080deg) scale(2); opacity: 1; } \r\n        }\r\n        @keyframes shockwave { 0% { transform: scale(0.5); opacity: 1; border-width: 20px; } 100% { transform: scale(4); opacity: 0; border-width: 0px; } }\r\n        @keyframes screen-shake { 0%, 100% { transform: translate(0, 0); } 10%, 30%, 50%, 70%, 90% { transform: translate(-5px, -5px); } 20%, 40%, 60%, 80% { transform: translate(5px, 5px); } }\r\n        \r\n        .bot-idle { animation: float 3s ease-in-out infinite; }\r\n        .bot-victory { \r\n            position: fixed !important; \r\n            left: 50% !important; \r\n            top: 50% !important; \r\n            animation: hyper-spin 1s cubic-bezier(0.68, -0.55, 0.27, 1.55) forwards !important; \r\n            z-index: 300; \r\n        }\r\n        .shake { animation: screen-shake 0.4s cubic-bezier(.36,.07,.19,.97) both; }\r\n\r\n        /* Cells & Effects */\r\n        .cell {\r\n            background: rgba(255, 255, 255, 0.09);\r\n            border: 1px solid rgba(255, 255, 255, 1);\r\n            aspect-ratio: 1/1;\r\n            display: flex;\r\n            align-items: center;\r\n            justify-content: center;\r\n            font-family: 'Orbitron', sans-serif;\r\n            font-size: 2.8rem;\r\n            font-weight: 900;\r\n            transition: all 0.2s;\r\n            cursor: pointer;\r\n        }\r\n\r\n        .winning-cell {\r\n            background: var(--win-bg) !important;\r\n            box-shadow: 0 0 30px var(--win-glow);\r\n            border-color: var(--win-glow) !important;\r\n            z-index: 10;\r\n            transform: scale(1.05);\r\n        }\r\n\r\n        .glitch-text {\r\n            position: relative;\r\n            animation: text-pulse 1s infinite alternate;\r\n        }\r\n        @keyframes text-pulse { from { transform: scale(1); text-shadow: 0 0 10px currentColor; } to { transform: scale(1.1); text-shadow: 0 0 30px currentColor; } }\r\n\r\n        .particle {\r\n            position: fixed;\r\n            pointer-events: none;\r\n            border-radius: 2px;\r\n            z-index: 250;\r\n        }\r\n\r\n        #shockwave-ring {\r\n            position: fixed;\r\n            left: 50%;\r\n            top: 50%;\r\n            width: 100px;\r\n            height: 100px;\r\n            border: 2px solid white;\r\n            border-radius: 50%;\r\n            transform: translate(-50%, -50%);\r\n            pointer-events: none;\r\n            opacity: 0;\r\n            z-index: 280;\r\n        }\r\n        .active-ring { animation: shockwave 0.8s ease-out forwards; }\r\n\r\n        .step { display: none; }\r\n        .step.active { display: flex; animation: fadeIn 0.4s ease; }\r\n        @keyframes fadeIn { from { opacity: 0; scale: 0.9; } to { opacity: 1; scale: 1; } }\r\n    </style>\r\n</head>\r\n<body>\r\n\r\n    <!-- OVERLAY MENUS -->\r\n    <div id=\"setup-modal\" class=\"fixed inset-0 z-[500] bg-black flex items-center justify-center p-8\">\r\n        <div class=\"w-full max-w-sm\">\r\n            <div id=\"step-1\" class=\"step active flex-col text-center\">\r\n                <h1 class=\"orbitron text-4xl font-black mb-10 tracking-[0.2em] text-cyan-400\">OXO HYPER</h1>\r\n                <button onclick=\"nextStep(2, 'ai')\" class=\"w-full mb-4 py-6 border border-cyan-500/30 bg-cyan-500/5 rounded-3xl orbitron font-bold\">SYSTEM VS PILOT</button>\r\n                <button onclick=\"nextStep(2, 'pvp')\" class=\"w-full py-6 border border-pink-500/30 bg-pink-500/5 rounded-3xl orbitron font-bold text-pink-500\">PILOT VS PILOT</button>\r\n            </div>\r\n            <div id=\"step-2\" class=\"step flex-col\">\r\n                <h1 class=\"orbitron text-xs font-black mb-8 text-center text-gray-500 uppercase tracking-widest\">ID Authentication</h1>\r\n                <input id=\"p1-input\" type=\"text\" placeholder=\"ID: PILOT 1\" class=\"w-full bg-white/5 border-b border-cyan-500 p-5 mb-4 outline-none orbitron text-center uppercase text-cyan-400\">\r\n                <input id=\"p2-input\" type=\"text\" placeholder=\"ID: PILOT 2\" class=\"w-full bg-white/5 border-b border-pink-500 p-5 mb-10 outline-none orbitron text-center uppercase text-pink-400\">\r\n                <button onclick=\"handleNames()\" class=\"w-full py-5 bg-cyan-500 text-black orbitron font-black rounded-2xl shadow-lg\">INITIALIZE</button>\r\n            </div>\r\n            <div id=\"step-3\" class=\"step flex-col\">\r\n                <h1 class=\"orbitron text-xs font-black mb-8 text-center text-gray-500 uppercase tracking-widest\">Core Difficulty</h1>\r\n                <button onclick=\"startGame(1)\" class=\"w-full mb-3 p-5 border border-white/10 rounded-2xl orbitron text-[10px] hover:bg-white/5 uppercase\">Novice</button>\r\n                <button onclick=\"startGame(2)\" class=\"w-full mb-3 p-5 border border-white/10 rounded-2xl orbitron text-[10px] hover:bg-white/5 uppercase\">Tactical</button>\r\n                <button onclick=\"startGame(3)\" class=\"w-full p-5 border border-cyan-500 bg-cyan-500/10 rounded-2xl orbitron text-[10px] text-cyan-400 uppercase\">God Mode</button>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- GAMEPLAY VIEW -->\r\n    <main id=\"game-container\" class=\"flex-1 flex flex-col p-6 max-w-lg mx-auto w-full\">\r\n        <header class=\"flex justify-between items-center mb-8\">\r\n            <div class=\"flex flex-col\">\r\n                <span id=\"display-p1\" class=\"font-black text-cyan-400 orbitron\">PILOT_X</span>\r\n                <span id=\"score-p1\" class=\"text-3xl font-black orbitron\">0</span>\r\n            </div>\r\n            <div id=\"hud-ring\" class=\"p-1 rounded-full border-2 border-white/10 transition-all duration-500\">\r\n                <div class=\"bg-white/5 px-6 py-2 rounded-full\">\r\n                    <span id=\"turn-txt\" class=\"orbitron text-[10px] font-black uppercase tracking-widest\">Awaiting</span>\r\n                </div>\r\n            </div>\r\n            <div class=\"flex flex-col text-right\">\r\n                <span id=\"display-p2\" class=\"font-black text-pink-400 orbitron\">PILOT_O</span>\r\n                <span id=\"score-p2\" class=\"text-3xl font-black orbitron\">0</span>\r\n            </div>\r\n        </header>\r\n\r\n        <div id=\"arena\" class=\"flex-1 flex items-center justify-center relative bg-white/[0.02] rounded-[3rem] border border-white/5 shadow-2xl overflow-hidden\">\r\n            <div id=\"chibi-bot\" class=\"bot-idle\">\r\n                <svg viewBox=\"0 0 100 100\">\r\n                    <circle cx=\"50\" cy=\"45\" r=\"35\" fill=\"black\" stroke=\"currentColor\" stroke-width=\"4\" id=\"bot-frame\" />\r\n                    <g fill=\"currentColor\" id=\"bot-eyes\">\r\n                        <ellipse cx=\"35\" cy=\"42\" rx=\"4\" ry=\"7\"><animate attributeName=\"ry\" values=\"7;1;7\" dur=\"3s\" repeatCount=\"indefinite\" /></ellipse>\r\n                        <ellipse cx=\"65\" cy=\"42\" rx=\"4\" ry=\"7\"><animate attributeName=\"ry\" values=\"7;1;7\" dur=\"3s\" repeatCount=\"indefinite\" /></ellipse>\r\n                    </g>\r\n                    <path d=\"M42 62 Q50 67 58 62\" stroke=\"currentColor\" stroke-width=\"3\" fill=\"none\" stroke-linecap=\"round\" />\r\n                    <path d=\"M25 82 L75 82 L80 95 L20 95 Z\" fill=\"#ff00ff\" opacity=\"0.6\" />\r\n                </svg>\r\n            </div>\r\n\r\n            <div id=\"grid\" class=\"grid grid-cols-3 gap-3 w-full aspect-square max-w-[320px] p-4 relative z-10\">\r\n                <div class=\"cell rounded-3xl\" onclick=\"handleTap(0)\"></div>\r\n                <div class=\"cell rounded-3xl\" onclick=\"handleTap(1)\"></div>\r\n                <div class=\"cell rounded-3xl\" onclick=\"handleTap(2)\"></div>\r\n                <div class=\"cell rounded-3xl\" onclick=\"handleTap(3)\"></div>\r\n                <div class=\"cell rounded-3xl\" onclick=\"handleTap(4)\"></div>\r\n                <div class=\"cell rounded-3xl\" onclick=\"handleTap(5)\"></div>\r\n                <div class=\"cell rounded-3xl\" onclick=\"handleTap(6)\"></div>\r\n                <div class=\"cell rounded-3xl\" onclick=\"handleTap(7)\"></div>\r\n                <div class=\"cell rounded-3xl\" onclick=\"handleTap(8)\"></div>\r\n            </div>\r\n        </div>\r\n\r\n        <footer class=\"mt-8 flex gap-4\">\r\n            <button onclick=\"location.reload()\" class=\"flex-1 p-5 border border-white/10 rounded-3xl orbitron text-[10px] text-gray-500 uppercase tracking-widest\">Exit</button>\r\n            <button onclick=\"resetStats()\" class=\"flex-1 p-5 bg-white/5 border border-white/10 rounded-3xl orbitron text-[10px] uppercase tracking-widest\">Wipe Data</button>\r\n        </footer>\r\n    </main>\r\n\r\n    <!-- VICTORY SCREEN -->\r\n    <div id=\"victory-overlay\" class=\"fixed inset-0 z-[400] hidden flex-col items-center justify-center bg-black/95\">\r\n        <div id=\"shockwave-ring\"></div>\r\n        <div class=\"relative z-[410] text-center\">\r\n            <p class=\"orbitron text-cyan-400 text-[10px] tracking-[0.5em] mb-4 uppercase\">Protocol Complete</p>\r\n            <h2 id=\"winner-name\" class=\"orbitron text-6xl font-black mb-8 italic glitch-text\">PILOT</h2>\r\n            <div class=\"flex gap-4 justify-center\">\r\n                <button onclick=\"initGame()\" class=\"px-12 py-5 bg-white text-black orbitron font-black rounded-2xl hover:bg-cyan-400 transition-colors\">NEXT MISSION</button>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <script>\r\n        let conf = { mode: 'ai', p1: 'X', p2: 'O', lvl: 3 };\r\n        let state = { board: Array(9).fill(''), turn: 'X', active: false, s1: 0, s2: 0, botThinking: false };\r\n\r\n        function nextStep(s, v) {\r\n            if (s === 2) { \r\n                conf.mode = v; \r\n                document.getElementById('p2-input').style.display = v === 'pvp' ? 'block' : 'none';\r\n            }\r\n            document.querySelectorAll('.step').forEach(el => el.classList.remove('active'));\r\n            document.getElementById(`step-${s}`).classList.add('active');\r\n        }\r\n\r\n        function handleNames() {\r\n            conf.p1 = document.getElementById('p1-input').value.toUpperCase() || 'PILOT_X';\r\n            conf.p2 = conf.mode === 'pvp' ? (document.getElementById('p2-input').value.toUpperCase() || 'PILOT_O') : 'SYSTEM_AI';\r\n            if (conf.mode === 'ai') nextStep(3);\r\n            else startGame();\r\n        }\r\n\r\n        function startGame(l = 1) {\r\n            conf.lvl = l;\r\n            document.getElementById('setup-modal').style.display = 'none';\r\n            document.getElementById('display-p1').innerText = conf.p1;\r\n            document.getElementById('display-p2').innerText = conf.p2;\r\n            initGame();\r\n        }\r\n\r\n        function initGame() {\r\n            // Reset Logical State\r\n            state.board = Array(9).fill('');\r\n            state.turn = 'X';\r\n            state.active = true;\r\n            state.botThinking = false;\r\n            \r\n            // UI Clean Up\r\n            const overlay = document.getElementById('victory-overlay');\r\n            overlay.classList.add('hidden');\r\n            overlay.style.display = 'none';\r\n            document.getElementById('shockwave-ring').classList.remove('active-ring');\r\n            \r\n            document.querySelectorAll('.cell').forEach(c => {\r\n                c.innerText = '';\r\n                c.className = 'cell rounded-3xl';\r\n                c.style.cssText = '';\r\n            });\r\n\r\n            // Re-center Bot\r\n            const bot = document.getElementById('chibi-bot');\r\n            bot.classList.remove('bot-victory');\r\n            bot.classList.add('bot-idle');\r\n            bot.style.position = 'absolute';\r\n            bot.style.left = '0';\r\n            bot.style.top = '0';\r\n            bot.style.transform = '';\r\n            \r\n            updateHUD();\r\n            \r\n            // Positioning Delay for Layout recalculation\r\n            setTimeout(() => { if (state.active) animateBot(4); }, 100);\r\n        }\r\n\r\n        function handleTap(i) {\r\n            if (!state.active || state.board[i] !== '' || state.botThinking) return;\r\n            \r\n            executeMove(i, state.turn);\r\n\r\n            if (state.active && conf.mode === 'ai' && state.turn === 'O') {\r\n                state.botThinking = true;\r\n                setTimeout(() => {\r\n                    if (!state.active) return;\r\n                    const aiIdx = getBestMove();\r\n                    executeMove(aiIdx, 'O');\r\n                    state.botThinking = false;\r\n                }, 600);\r\n            }\r\n        }\r\n\r\n        function executeMove(i, char) {\r\n            state.board[i] = char;\r\n            const cells = document.querySelectorAll('.cell');\r\n            cells[i].innerText = char;\r\n            cells[i].style.color = char === 'X' ? 'var(--neon-blue)' : 'var(--neon-pink)';\r\n            cells[i].style.textShadow = `0 0 20px ${char === 'X' ? 'var(--neon-blue)' : 'var(--neon-pink)'}`;\r\n            \r\n            animateBot(i);\r\n            \r\n            const win = checkWin(state.board);\r\n            if (win) {\r\n                triggerVictory(win);\r\n            } else {\r\n                state.turn = state.turn === 'X' ? 'O' : 'X';\r\n                updateHUD();\r\n            }\r\n        }\r\n\r\n        function animateBot(idx) {\r\n            const bot = document.getElementById('chibi-bot');\r\n            if (bot.classList.contains('bot-victory')) return;\r\n\r\n            const target = document.querySelectorAll('.cell')[idx];\r\n            if (!target) return;\r\n            \r\n            const arena = document.getElementById('arena').getBoundingClientRect();\r\n            const rect = target.getBoundingClientRect();\r\n            \r\n            const x = (rect.left + rect.width/2) - arena.left - 30;\r\n            const y = (rect.top + rect.height/2) - arena.top - 30;\r\n            \r\n            bot.style.transform = `translate(${x}px, ${y}px)`;\r\n        }\r\n\r\n        function updateHUD() {\r\n            const isX = state.turn === 'X';\r\n            const color = isX ? 'var(--neon-blue)' : 'var(--neon-pink)';\r\n            document.getElementById('turn-txt').innerText = isX ? conf.p1 : conf.p2;\r\n            document.getElementById('turn-txt').style.color = color;\r\n            document.getElementById('hud-ring').style.borderColor = color;\r\n            document.getElementById('chibi-bot').style.color = color;\r\n            document.getElementById('score-p1').innerText = state.s1;\r\n            document.getElementById('score-p2').innerText = state.s2;\r\n        }\r\n\r\n        function triggerVictory(res) {\r\n            state.active = false;\r\n            const bot = document.getElementById('chibi-bot');\r\n            const overlay = document.getElementById('victory-overlay');\r\n            const nameEl = document.getElementById('winner-name');\r\n            const color = res.winner === 'X' ? 'var(--neon-blue)' : (res.winner === 'O' ? 'var(--neon-pink)' : '#ffffff');\r\n\r\n            document.getElementById('game-container').classList.add('shake');\r\n            setTimeout(() => document.getElementById('game-container').classList.remove('shake'), 500);\r\n\r\n            if (res.winner === 'X') state.s1++; else if (res.winner === 'O') state.s2++;\r\n            updateHUD();\r\n\r\n            if (res.path) {\r\n                res.path.forEach(idx => {\r\n                    const c = document.querySelectorAll('.cell')[idx];\r\n                    c.classList.add('winning-cell');\r\n                    c.style.setProperty('--win-bg', res.winner === 'X' ? 'rgba(0,243,255,0.1)' : 'rgba(255,0,255,0.1)');\r\n                    c.style.setProperty('--win-glow', color);\r\n                });\r\n            }\r\n\r\n            setTimeout(() => {\r\n                bot.style.transform = '';\r\n                bot.classList.remove('bot-idle');\r\n                bot.classList.add('bot-victory');\r\n                bot.style.color = color;\r\n                \r\n                setTimeout(() => {\r\n                    document.getElementById('shockwave-ring').classList.add('active-ring');\r\n                    document.getElementById('shockwave-ring').style.borderColor = color;\r\n                    createParticles(color);\r\n                    \r\n                    overlay.classList.remove('hidden');\r\n                    overlay.style.display = 'flex';\r\n                    if (res.winner === 'T') {\r\n                        nameEl.innerText = \"DRAW\";\r\n                        nameEl.style.color = \"white\";\r\n                    } else {\r\n                        nameEl.innerText = res.winner === 'X' ? conf.p1 : conf.p2;\r\n                        nameEl.style.color = color;\r\n                    }\r\n                }, 800);\r\n            }, 300);\r\n        }\r\n\r\n        function createParticles(color) {\r\n            for(let i=0; i<40; i++) {\r\n                const p = document.createElement('div');\r\n                p.className = 'particle';\r\n                const size = Math.random() * 12 + 4;\r\n                p.style.width = size + 'px';\r\n                p.style.height = '2px';\r\n                p.style.background = color;\r\n                p.style.left = '50%';\r\n                p.style.top = '50%';\r\n                const angle = Math.random() * Math.PI * 2;\r\n                const dist = 300 + Math.random() * 500;\r\n                const tx = Math.cos(angle) * dist;\r\n                const ty = Math.sin(angle) * dist;\r\n                document.body.appendChild(p);\r\n                p.animate([\r\n                    { transform: `translate(-50%, -50%) rotate(${angle}rad) translateX(0)`, opacity: 1 },\r\n                    { transform: `translate(-50%, -50%) rotate(${angle}rad) translateX(${tx}px) translateY(${ty}px)`, opacity: 0 }\r\n                ], { duration: 800 + Math.random() * 1000, easing: 'ease-out' }).onfinish = () => p.remove();\r\n            }\r\n        }\r\n\r\n        function checkWin(b) {\r\n            const paths = [[0,1,2],[3,4,5],[6,7,8],[0,3,6],[1,4,7],[2,5,8],[0,4,8],[2,4,6]];\r\n            for (let p of paths) {\r\n                if (b[p[0]] && b[p[0]] === b[p[1]] && b[p[0]] === b[p[2]]) return { winner: b[p[0]], path: p };\r\n            }\r\n            return b.includes('') ? null : { winner: 'T' };\r\n        }\r\n\r\n        function getBestMove() {\r\n            if (conf.lvl === 1) {\r\n                const a = state.board.map((v,i)=>v===''?i:null).filter(v=>v!==null);\r\n                return a[Math.floor(Math.random()*a.length)];\r\n            }\r\n            if (conf.lvl === 2) {\r\n                let m = findImmediateWin('O') || findImmediateWin('X');\r\n                if (m !== null) return m;\r\n                const a = state.board.map((v,i)=>v===''?i:null).filter(v=>v!==null);\r\n                return a[Math.floor(Math.random()*a.length)];\r\n            }\r\n            return minimax(state.board, 0, true).index;\r\n        }\r\n\r\n        function findImmediateWin(p) {\r\n            for(let i=0; i<9; i++) {\r\n                if(state.board[i]==='') {\r\n                    state.board[i]=p;\r\n                    const w = checkWin(state.board);\r\n                    state.board[i]='';\r\n                    if(w && w.winner === p) return i;\r\n                }\r\n            }\r\n            return null;\r\n        }\r\n\r\n        function minimax(nb, d, isM) {\r\n            const r = checkWin(nb);\r\n            if (r?.winner === 'O') return { score: 10 - d };\r\n            if (r?.winner === 'X') return { score: d - 10 };\r\n            if (!nb.includes('')) return { score: 0 };\r\n            const moves = [];\r\n            const avail = nb.map((v,i)=>v===''?i:null).filter(v=>v!==null);\r\n            for(let i=0; i<avail.length; i++) {\r\n                const m = { index: avail[i] };\r\n                nb[avail[i]] = isM ? 'O' : 'X';\r\n                m.score = minimax(nb, d+1, !isM).score;\r\n                nb[avail[i]] = '';\r\n                moves.push(m);\r\n            }\r\n            let best;\r\n            if(isM) {\r\n                let s = -Infinity;\r\n                for(let m of moves) { if(m.score > s) { s = m.score; best = m; } }\r\n            } else {\r\n                let s = Infinity;\r\n                for(let m of moves) { if(m.score < s) { s = m.score; best = m; } }\r\n            }\r\n            return best;\r\n        }\r\n\r\n        function resetStats() {\r\n            state.s1 = 0;\r\n            state.s2 = 0;\r\n            updateHUD();\r\n        }\r\n    </script>\r\n</body>\r\n</html>"
